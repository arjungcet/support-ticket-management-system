# Copy to .env (git-ignored) and change the values. Never commit real credentials (rules/security.md §1).

# docker-compose.yml — local PostgreSQL
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=change-me
# Host port for the container. Use e.g. 5433 if a local PostgreSQL already listens on 5432,
# and use the same port in SPRING_DATASOURCE_URL below.
POSTGRES_PORT=5432

# Backend (Spring Boot) — required outside the h2 profile; there are no defaults
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/supportdesk
SPRING_DATASOURCE_USERNAME=supportdesk
SPRING_DATASOURCE_PASSWORD=change-me

# Frontend (Next.js server) — where /api/* is proxied at runtime
BACKEND_URL=http://localhost:8080
